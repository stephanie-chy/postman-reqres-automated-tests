					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"name\": \"{{updated_name}}\",\r\n    \"job\": \"{{updated_job}}\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base-url}}/api/users/{{data_id}}",
					"host": [
						"{{base-url}}"
					],
					"path": [
						"api",
						"users",
						"{{data_id}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "New Request",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const randomId = Math.floor(Math.random() * 10) + 1;\r",
							"pm.environment.set(\"delete_data_id\", randomId);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// TC01: Verify status code is 204 (No Content).\r",
							"pm.test(\"Status is 201\", () => pm.response.to.have.status(204));\r",
							"\r",
							"const response = pm.response.text();\r",
							"\r",
							"// TC02: Verify response body is empty.\r",
							"pm.test(\"Response body is empty\", () => {\r",
							"    pm.expect(response).to.eql(\"\");\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "DELETE",
