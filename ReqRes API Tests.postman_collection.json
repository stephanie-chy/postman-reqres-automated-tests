					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// TC01: Verify status code is 200 (OK).\r",
							"pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\r",
							"\r",
							"const response = pm.response.json();\r",
							"\r",
							"// TC02: Verify response contains name, job, id, and updatedAt fields.\r",
							"pm.test(\"Response contains name, job, and updatedAt felds.\", () => {\r",
